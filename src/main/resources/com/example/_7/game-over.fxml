<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@game-over.css" styleClass="result-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example._7.ui.screen.GameOverScreenController">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="result-header">
            <VBox spacing="1.0">
                <Label text="冒險結算" styleClass="screen-title"/>
                <Label text="ADVENTURE SUMMARY" styleClass="screen-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblResultBadge" text="DEFEATED" styleClass="result-badge"/>
        </HBox>
    </top>

    <center>
        <StackPane>
            <VBox fx:id="resultCard" alignment="CENTER" spacing="14.0"
                  prefWidth="650.0" maxWidth="650.0"
                  prefHeight="480.0" minHeight="480.0" maxHeight="480.0"
                  styleClass="result-card">
                <Label fx:id="lblTitle" text="戰敗" styleClass="result-title"/>
                <Label fx:id="lblSummary" text="冒險在此告一段落"
                       wrapText="true" textAlignment="CENTER" styleClass="result-summary"/>

                <HBox alignment="CENTER" spacing="28.0">
                    <StackPane prefHeight="235.0" prefWidth="220.0" styleClass="portrait-frame">
                        <ImageView fx:id="characterPortrait" fitHeight="225.0" fitWidth="210.0"
                                   preserveRatio="true" smooth="true"/>
                        <Label fx:id="lblPortraitMark" text="DEFEATED" styleClass="portrait-mark"/>
                    </StackPane>

                    <VBox spacing="10.0" prefWidth="300.0">
                        <VBox spacing="3.0" styleClass="identity-panel">
                            <Label fx:id="lblPlayerName" text="玩家" styleClass="player-name"/>
                            <Label fx:id="lblPlayerClass" text="戰士" styleClass="player-class"/>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" styleClass="stat-row">
                            <Label text="抵達回合" styleClass="stat-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblRound" text="1 / 5" styleClass="stat-value"/>
                        </HBox>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER" spacing="14.0">
                    <Button text="返回主選單" onAction="#onBackToMainMenu" styleClass="menu-button"/>
                </HBox>
            </VBox>
        </StackPane>
    </center>
    <padding>
        <Insets bottom="22.0" left="28.0" right="28.0" top="14.0"/>
    </padding>
</BorderPane>
