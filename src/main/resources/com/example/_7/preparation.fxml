<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="650.0" prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/11.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example._7.ui.screen.PreparationScreenController">
    <children>
        <VBox spacing="10.0" AnchorPane.topAnchor="10.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.bottomAnchor="10.0">
            <children>
                <HBox spacing="12.0">
                    <children>
                        <AnchorPane fx:id="charInfoContainer" prefWidth="240.0" prefHeight="100.0" />
                        <AnchorPane fx:id="healthBarContainer" prefWidth="240.0" prefHeight="100.0" />
                    </children>
                </HBox>

                <HBox spacing="12.0" VBox.vgrow="ALWAYS">
                    <children>
                        <AnchorPane fx:id="shopPanelContainer" prefWidth="230.0" prefHeight="440.0" />
                        <AnchorPane fx:id="storageContainer" prefWidth="260.0" prefHeight="440.0" />
                        <AnchorPane fx:id="backpackContainer" prefWidth="320.0" prefHeight="440.0" />
                        <AnchorPane fx:id="itemCardContainer" prefWidth="270.0" prefHeight="440.0" />
                    </children>
                </HBox>

                <HBox spacing="8.0">
                    <children>
                        <Button fx:id="btnStartBattle" text="Start Battle" onAction="#onStartBattle"/>
                        <Button fx:id="btnRefreshShop" text="Refresh Shop ($1)" onAction="#onRefreshShop"/>
                        <Button fx:id="btnOpenStorage" text="Storage Help" onAction="#onOpenStorage"/>
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets top="8" right="8" bottom="8" left="8"/>
            </padding>
        </VBox>
    </children>
</AnchorPane>
