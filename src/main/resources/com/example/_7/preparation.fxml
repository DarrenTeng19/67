<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@preparation.css"
            styleClass="preparation-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example._7.ui.screen.PreparationScreenController">
    <top>
        <VBox spacing="12.0" styleClass="top-area">
            <HBox alignment="CENTER_LEFT">
                <VBox spacing="1.0">
                    <Label text="準備階段" styleClass="screen-title"/>
                    <Label text="PREPARATION PHASE" styleClass="screen-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblRoundBadge" text="ROUND 1" styleClass="round-badge"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="14.0">
                <StackPane prefHeight="145.0" prefWidth="145.0" styleClass="portrait-card">
                    <ImageView fx:id="characterPortrait" fitHeight="137.0" fitWidth="137.0"
                               preserveRatio="true" smooth="true"/>
                </StackPane>
                <AnchorPane fx:id="charInfoContainer" prefHeight="145.0" prefWidth="260.0"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="status-card"/>
                <AnchorPane fx:id="healthBarContainer" prefHeight="145.0" prefWidth="300.0"
                            maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="status-card"/>
                <HBox alignment="CENTER" spacing="12.0" prefWidth="430.0" maxWidth="430.0"
                      styleClass="guide-card">
                    <Button text="道具一覽" onAction="#onShowItems" styleClass="guide-action-button"/>
                    <Button text="合成配方" onAction="#onShowRecipes" styleClass="guide-action-button"/>
                </HBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <StackPane styleClass="wood-frame">
            <HBox alignment="TOP_CENTER" spacing="12.0" styleClass="workspace">
                <VBox prefWidth="260.0" spacing="7.0" styleClass="work-panel, shop-stall">
                <HBox alignment="CENTER_LEFT" spacing="7.0" styleClass="wood-sign">
                    <Label text="●" styleClass="iron-nail"/>
                    <Label text="商店" styleClass="panel-heading, light-heading"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblShopCount" text="0" styleClass="parchment-tag"/>
                    <Label text="●" styleClass="iron-nail"/>
                </HBox>
                <AnchorPane fx:id="shopPanelContainer" VBox.vgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="30.0" styleClass="stall-plank">
                    <Label text="◆" styleClass="plank-mark"/>
                    <Label text="◆" styleClass="plank-mark"/>
                    <Label text="◆" styleClass="plank-mark"/>
                </HBox>
                </VBox>

                <VBox prefWidth="215.0" spacing="7.0" styleClass="work-panel, storage-crate">
                <HBox alignment="CENTER_LEFT" spacing="7.0" styleClass="crate-header">
                    <Label text="▣" styleClass="crate-mark"/>
                    <Label text="儲物箱" styleClass="panel-heading"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblStorageCount" text="0" styleClass="cloth-tag"/>
                </HBox>
                <AnchorPane fx:id="storageContainer" VBox.vgrow="ALWAYS"/>
                <HBox alignment="CENTER" styleClass="rope-band">
                    <Label text="· · · · · · · · · · · ·" styleClass="rope-stitch"/>
                </HBox>
                </VBox>

                <VBox prefWidth="295.0" spacing="7.0" styleClass="work-panel, leather-backpack">
                <HBox alignment="CENTER_LEFT" spacing="7.0" styleClass="leather-flap">
                    <Label text="✦" styleClass="brass-rivet"/>
                    <Label text="戰鬥背包" styleClass="panel-heading, light-heading"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblBackpackCount" text="0 / 25" styleClass="brass-tag"/>
                </HBox>
                <AnchorPane fx:id="backpackContainer" VBox.vgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="80.0">
                    <Label text="●" styleClass="brass-rivet"/>
                    <Label text="●" styleClass="brass-rivet"/>
                </HBox>
                </VBox>

                <VBox prefWidth="220.0" spacing="7.0" styleClass="work-panel, adventure-book">
                <HBox alignment="CENTER_LEFT" spacing="7.0" styleClass="book-header">
                    <Label text="物品誌" styleClass="book-tab"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Ⅰ" styleClass="page-number"/>
                </HBox>
                <AnchorPane fx:id="itemCardContainer" VBox.vgrow="ALWAYS"/>
                <HBox alignment="CENTER" spacing="5.0">
                    <Region prefWidth="55.0" styleClass="ink-line"/>
                    <Label text="❖" styleClass="ink-ornament"/>
                    <Region prefWidth="55.0" styleClass="ink-line"/>
                </HBox>
                </VBox>
            </HBox>
        </StackPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" minHeight="70.0" prefHeight="70.0" spacing="10.0" styleClass="action-bar">
            <Button fx:id="btnRefreshShop" text="↻  刷新  $1" onAction="#onRefreshShop"
                    styleClass="secondary-action"/>
            <Button fx:id="btnAutoCraft" text="✦  合成" onAction="#onAutoCraft"
                    styleClass="secondary-action"/>
            <Button fx:id="btnOpenStorage" text="▣  儲物箱" onAction="#onOpenStorage"
                    styleClass="secondary-action"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnStartBattle" text="開始戰鬥  ›" onAction="#onStartBattle"
                    styleClass="primary-action"/>
        </HBox>
    </bottom>
</BorderPane>
