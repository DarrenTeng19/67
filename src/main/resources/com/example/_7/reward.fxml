<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@reward.css" styleClass="reward-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example._7.ui.screen.RewardScreenController">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="reward-header">
            <VBox spacing="1.0">
                <Label text="勝利結算" styleClass="screen-title"/>
                <Label text="VICTORY SUMMARY" styleClass="screen-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="VICTORY" styleClass="victory-badge"/>
        </HBox>
    </top>

    <center>
        <StackPane>
            <VBox alignment="CENTER" spacing="14.0"
                  prefWidth="650.0" maxWidth="650.0"
                  prefHeight="480.0" minHeight="480.0" maxHeight="480.0"
                  styleClass="reward-card">
                <Label fx:id="lblTitle" text="戰鬥勝利" styleClass="reward-title"/>
                <Label fx:id="lblSummary" text="你成功通過第 1 回合"
                       styleClass="reward-summary"/>

                <HBox alignment="CENTER" spacing="28.0">
                    <StackPane prefHeight="235.0" prefWidth="220.0" styleClass="portrait-frame">
                        <ImageView fx:id="characterPortrait" fitHeight="225.0" fitWidth="210.0"
                                   preserveRatio="true" smooth="true"/>
                        <Label text="VICTORY" styleClass="portrait-mark"/>
                    </StackPane>

                    <VBox spacing="10.0" prefWidth="300.0">
                        <VBox spacing="3.0" styleClass="identity-panel">
                            <Label fx:id="lblPlayerName" text="玩家" styleClass="player-name"/>
                            <Label fx:id="lblPlayerClass" text="戰士" styleClass="player-class"/>
                        </VBox>

                        <HBox alignment="CENTER_LEFT" styleClass="stat-row">
                            <Label text="通過回合" styleClass="stat-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblRound" text="1 / 5" styleClass="stat-value"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" styleClass="stat-row, reward-row">
                            <Label text="獲得金幣" styleClass="stat-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="lblGoldReward" text="+10 G" styleClass="stat-value, gold-value"/>
                        </HBox>
                    </VBox>
                </HBox>

                <Button text="繼續冒險" onAction="#onContinue" styleClass="continue-button"/>
            </VBox>
        </StackPane>
    </center>
    <padding>
        <Insets bottom="22.0" left="28.0" right="28.0" top="14.0"/>
    </padding>
</BorderPane>
