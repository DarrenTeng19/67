<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="root" prefHeight="700.0" prefWidth="1100.0"
            stylesheets="@battle.css" styleClass="battle-root"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example._7.ui.screen.BattleScreenController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="battle-header">
            <VBox spacing="1.0">
                <Label text="戰鬥階段" styleClass="screen-title"/>
                <Label text="BATTLE PHASE" styleClass="screen-subtitle"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblRound" text="ROUND 1 / 5" styleClass="round-badge"/>
            <Label fx:id="lblBattleState" text="戰鬥進行中" styleClass="live-badge"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="12.0" styleClass="battle-content">
            <HBox alignment="CENTER" spacing="22.0" VBox.vgrow="ALWAYS">
                <VBox alignment="TOP_CENTER" spacing="9.0" prefWidth="405.0"
                      maxWidth="405.0" styleClass="combatant-card, player-card">
                    <HBox alignment="CENTER_LEFT">
                        <VBox spacing="1.0">
                            <Label fx:id="lblPlayerName" text="Player" styleClass="combatant-name"/>
                            <Label fx:id="lblPlayerClass" text="WARRIOR" styleClass="class-label"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label text="我方" styleClass="side-tag, player-tag"/>
                    </HBox>

                    <StackPane fx:id="playerPortraitPane" prefHeight="215.0" prefWidth="285.0"
                               styleClass="portrait-frame, player-portrait">
                        <ImageView fx:id="playerPortrait" fitHeight="205.0" fitWidth="275.0"
                                   preserveRatio="true" smooth="true"/>
                        <Label fx:id="lblPlayerDamage" text="" mouseTransparent="true"
                               styleClass="damage-popup"/>
                    </StackPane>

                    <VBox spacing="7.0" styleClass="resource-panel">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="生命" styleClass="resource-name, hp-name"/>
                            <StackPane HBox.hgrow="ALWAYS">
                                <ProgressBar fx:id="playerHpBar" progress="1.0" maxWidth="Infinity"
                                             styleClass="resource-bar, hp-bar"/>
                                <Label fx:id="lblPlayerHp" text="0 / 0" styleClass="resource-value"/>
                            </StackPane>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="耐力" styleClass="resource-name, stamina-name"/>
                            <StackPane HBox.hgrow="ALWAYS">
                                <ProgressBar fx:id="playerStaminaBar" progress="1.0" maxWidth="Infinity"
                                             styleClass="resource-bar, stamina-bar"/>
                                <Label fx:id="lblPlayerStamina" text="0 / 0" styleClass="resource-value"/>
                            </StackPane>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="魔力" styleClass="resource-name, mana-name"/>
                            <StackPane HBox.hgrow="ALWAYS">
                                <ProgressBar fx:id="playerManaBar" progress="1.0" maxWidth="Infinity"
                                             styleClass="resource-bar, mana-bar"/>
                                <Label fx:id="lblPlayerMana" text="0 / 0" styleClass="resource-value"/>
                            </StackPane>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="護盾" styleClass="resource-name, shield-name"/>
                            <StackPane HBox.hgrow="ALWAYS">
                                <ProgressBar fx:id="playerShieldBar" progress="0.0" maxWidth="Infinity"
                                             styleClass="resource-bar, shield-bar"/>
                                <Label fx:id="lblPlayerShield" text="0" styleClass="resource-value"/>
                            </StackPane>
                        </HBox>
                    </VBox>

                    <VBox spacing="5.0" styleClass="effects-panel">
                        <Label text="狀態效果" styleClass="section-label"/>
                        <FlowPane fx:id="playerEffects" hgap="6.0" vgap="5.0" prefWrapLength="365.0"/>
                    </VBox>
                </VBox>

                <VBox alignment="CENTER" spacing="16.0" prefWidth="170.0" maxWidth="170.0">
                    <Label text="VS" styleClass="versus-label"/>
                    <VBox alignment="CENTER" spacing="5.0" styleClass="event-card">
                        <Label text="最近行動" styleClass="section-label"/>
                        <Label fx:id="lblLastAction" text="戰鬥開始" wrapText="true"
                               textAlignment="CENTER" styleClass="last-action"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="8.0" styleClass="control-card">
                        <Label text="戰鬥速度" styleClass="section-label"/>
                        <HBox alignment="CENTER" spacing="6.0">
                            <Button fx:id="btnSpeed1x" text="1x" onAction="#onSpeed1x"
                                    styleClass="control-button, active-control"/>
                            <Button fx:id="btnSpeed2x" text="2x" onAction="#onSpeed2x"
                                    styleClass="control-button"/>
                        </HBox>
                        <Button fx:id="btnPause" text="暫停" onAction="#onPause"
                                maxWidth="Infinity" styleClass="pause-button"/>
                        <Button fx:id="btnResume" text="繼續" onAction="#onResume"
                                maxWidth="Infinity" visible="false" managed="false"
                                styleClass="resume-button"/>
                    </VBox>
                </VBox>

                <VBox alignment="TOP_CENTER" spacing="9.0" prefWidth="405.0"
                      maxWidth="405.0" styleClass="combatant-card, enemy-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="敵方" styleClass="side-tag, enemy-tag"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <VBox alignment="TOP_RIGHT" spacing="1.0">
                            <Label fx:id="lblEnemyName" text="Enemy" styleClass="combatant-name"/>
                            <Label fx:id="lblEnemyClass" text="WARRIOR" styleClass="class-label"/>
                        </VBox>
                    </HBox>

                    <StackPane fx:id="enemyPortraitPane" prefHeight="215.0" prefWidth="285.0"
                               styleClass="portrait-frame, enemy-portrait">
                        <ImageView fx:id="enemyPortrait" fitHeight="205.0" fitWidth="275.0"
                                   preserveRatio="true" smooth="true" scaleX="-1.0"/>
                        <Label fx:id="lblEnemyDamage" text="" mouseTransparent="true"
                               styleClass="damage-popup"/>
                    </StackPane>

                    <VBox spacing="7.0" styleClass="resource-panel">
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="生命" styleClass="resource-name, hp-name"/>
                            <StackPane HBox.hgrow="ALWAYS">
                                <ProgressBar fx:id="enemyHpBar" progress="1.0" maxWidth="Infinity"
                                             styleClass="resource-bar, hp-bar"/>
                                <Label fx:id="lblEnemyHp" text="0 / 0" styleClass="resource-value"/>
                            </StackPane>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="耐力" styleClass="resource-name, stamina-name"/>
                            <StackPane HBox.hgrow="ALWAYS">
                                <ProgressBar fx:id="enemyStaminaBar" progress="1.0" maxWidth="Infinity"
                                             styleClass="resource-bar, stamina-bar"/>
                                <Label fx:id="lblEnemyStamina" text="0 / 0" styleClass="resource-value"/>
                            </StackPane>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="魔力" styleClass="resource-name, mana-name"/>
                            <StackPane HBox.hgrow="ALWAYS">
                                <ProgressBar fx:id="enemyManaBar" progress="1.0" maxWidth="Infinity"
                                             styleClass="resource-bar, mana-bar"/>
                                <Label fx:id="lblEnemyMana" text="0 / 0" styleClass="resource-value"/>
                            </StackPane>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <Label text="護盾" styleClass="resource-name, shield-name"/>
                            <StackPane HBox.hgrow="ALWAYS">
                                <ProgressBar fx:id="enemyShieldBar" progress="0.0" maxWidth="Infinity"
                                             styleClass="resource-bar, shield-bar"/>
                                <Label fx:id="lblEnemyShield" text="0" styleClass="resource-value"/>
                            </StackPane>
                        </HBox>
                    </VBox>

                    <VBox spacing="5.0" styleClass="effects-panel">
                        <Label text="狀態效果" styleClass="section-label"/>
                        <FlowPane fx:id="enemyEffects" hgap="6.0" vgap="5.0" prefWrapLength="365.0"/>
                    </VBox>
                </VBox>
            </HBox>

            <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        prefHeight="120.0" minHeight="120.0" maxHeight="120.0"
                        styleClass="battle-log-scroll">
                <content>
                    <VBox fx:id="battleLog" spacing="2.0" styleClass="battle-log"/>
                </content>
            </ScrollPane>
        </VBox>
    </center>
    <padding>
        <Insets bottom="0.0" left="0.0" right="0.0" top="0.0"/>
    </padding>
</BorderPane>
